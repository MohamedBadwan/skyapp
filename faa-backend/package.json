{
  "name": "faa-ap-exam-backend",
  "version": "1.0.0",
  "description": "Backend API (Express + TypeScript + MongoDB) para el FAA A&P Exam Trainer — autenticación, banco de preguntas protegido, generación de exámenes y progreso del alumno.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "ts-node --files src/seed/seed.ts",
    "seed:prod": "node dist/seed/seed.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "faa",
    "a&p",
    "exam",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "JJ Aeronautic Services",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5",
    "stripe": "^22.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
