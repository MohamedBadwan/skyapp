# ---- Servidor ----
NODE_ENV=development
PORT=4000

# ---- Base de datos ----
# Local: mongodb://127.0.0.1:27017/faa_exam
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/faa_exam
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/faa_exam?retryWrites=true&w=majority

# ---- JWT ----
# Cambia estos secretos por cadenas largas y aleatorias en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Origen(es) permitido(s), separados por coma. Usa * solo en desarrollo.
CORS_ORIGIN=*
# URL pública del frontend usada en enlaces de invitación
APP_URL=http://localhost:3000

# ---- Admin inicial (para el seed) ----
ADMIN_EMAIL=admin@jjaeronautic.com
ADMIN_PASSWORD=Cambia_Esta_Clave_123

# ---- Correo de restablecimiento (Namecheap Private Email) ----
# SMTP_USER y SMTP_PASSWORD son la dirección completa y contraseña del buzón
# que enviará los códigos. Private Email usa mail.privateemail.com:465 con SSL.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@tu-dominio.com
SMTP_PASSWORD=tu-contrasena-del-buzon
SMTP_FROM=no-reply@tu-dominio.com

# ---- Stripe ----
# Obtén estas claves desde https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secreto del webhook: stripe listen --forward-to localhost:4000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Precio de la suscripción mensual (en centavos: 999 = $9.99)
STRIPE_SUBSCRIPTION_AMOUNT=999
STRIPE_SUBSCRIPTION_CURRENCY=usd
STRIPE_PRODUCT_NAME=SkyMentor Monthly
# Opcional: si prefieres usar un Price pre-creado en Stripe Dashboard, descomenta:
# STRIPE_PRICE_ID=price_...
# URLs a las que Stripe redirige después del checkout
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel
